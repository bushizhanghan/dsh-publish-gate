{
  "name": "@bushizhanghan/dsh-publish-gate",
  "version": "0.5.0",
  "description": "Pre-publish gate for DSH plugins in five layers: manifest, dependencies, artifact, runtime, browser half — plus traceability (can you point at the bytes you shipped?). 发布前门禁：清单、依赖、产物、运行时、浏览器半边，外加可追溯性。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "publish",
    "preflight",
    "npm",
    "market",
    "agent-tools"
  ],
  "author": "bushizhanghan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushizhanghan/dsh-publish-gate.git"
  },
  "bugs": {
    "url": "https://github.com/bushizhanghan/dsh-publish-gate/issues"
  },
  "homepage": "https://github.com/bushizhanghan/dsh-publish-gate#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
